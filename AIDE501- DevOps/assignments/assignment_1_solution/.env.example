# Copy to .env and replace the values. .env is git-ignored and docker-ignored:
# secrets never go into Git or into an image.
#
# Generate strong values:
#   macOS/Linux:  openssl rand -hex 32
#   PowerShell:   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })

POSTGRES_PASSWORD=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Image version used by docker-compose.yml (local build tag) and
# docker-compose.deploy.yml (tag pulled from the registry).
TAG=1.0.0

# Host port for the website. Local default 8080; on the VM/EC2 use 80.
# WEB_PORT=80
